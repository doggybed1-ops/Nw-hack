local function eligible(player,cam,center,silent,inFlight)
    if player==P or (player.Team and player.Team.Name=="Visitors") then return end
    if C.SpecificPlayer and (C.TargetUsername=="" or player.Name:lower()~=C.TargetUsername:lower()) then return end
    if C.FlagBearersOnly and not isFlagBearer(player) then return end
    if C.TeamCheck and P.Team and player.Team==P.Team then return end
    local c=player.Character
    if not c or not c:IsDescendantOf(workspace) then return end
    local h=c:FindFirstChildOfClass("Humanoid")
    local p=c:FindFirstChild(C.Part) or c:FindFirstChild("UpperTorso")
    if not h or h.Health<=0 or not p or not p:IsA("BasePart") or c:FindFirstChildOfClass("ForceField") then return end
    local delta=p.Position-cam.CFrame.Position
    if delta.Magnitude>C.MaxDistance or delta.Magnitude<.01 then return end
    local screen,visible=cam:WorldToViewportPoint(p.Position)
    local distance=(Vector2.new(screen.X,screen.Y)-center).Magnitude
    if not inFlight and (not visible or distance>C.Radius) then return end
    if (silent and not C.ThroughWalls) or (not silent and C.Visibility) then
        local hit=workspace:Raycast(cam.CFrame.Position,delta,params)
        if hit and not hit.Instance:IsDescendantOf(c) then return end
    end
    if C.FlagPriority and isFlagBearer(player) then distance=distance-100000 end
    return p,distance
end
selectSilentTarget=function(previous,onlyPrevious)
    local cam=workspace.CurrentCamera
    local own=P.Character
    local humanoid=own and own:FindFirstChildOfClass("Humanoid")
    if not cam or not humanoid or humanoid.Health<=0 then return end
    local center=cursorViewport()
    params.FilterDescendantsInstances={cam,own}
    if onlyPrevious then
        if not previous then return end
        local part=eligible(previous,cam,center,true,onlyPrevious=="flight")
        if part then return previous,part end
        return
    end
    if C.Sticky and previous and (not C.FlagPriority or isFlagBearer(previous)) then
        local part=eligible(previous,cam,center,true)
        if part then return previous,part end
    end
    local selected,selectedPart,best=nil,nil,math.huge
    for _,player in ipairs(Players:GetPlayers()) do
        local part,distance=eligible(player,cam,center,true)
        if part and distance<best then
            selected,selectedPart,best=player,part,distance
        end
    end
    return selected,selectedPart
end

local Http=game:GetService("HttpService")
local configFolder=VG_ASSET_FOLDER.."/configs"
local function checkedName(name)
    assert(type(name)=="string" and #name>0 and #name<=40 and name:match("^[%w_-]+$"),"Use 1–40 letters, digits, underscores or hyphens")
    assert(name~="autoload","Choose a different profile name")
    return name
end
local function ensureConfigs()
    assert(type(writefile)=="function" and type(readfile)=="function","Filesystem unavailable")
    if not isfolder(configFolder) then makefolder(configFolder) end
end
local function validatedSettings(input)
    assert(type(input)=="table","Invalid settings")
    local output=table.clone(defaults)
    for k,v in pairs(input) do
        -- Migrate older profiles by dropping the removed feature.
        if k=="BulletFlySeconds" or k=="ThroughWalls" or k=="HitboxExtender" or k=="HitboxScale" or k=="InstantReload" or k=="AutomaticFire" or k=="FireInterval" then continue end
        assert(defaults[k]~=nil,"Unknown setting: "..tostring(k))
        assert(type(v)==type(defaults[k]),"Invalid type: "..k)
        if type(v)=="number" then
            local bounds=ranges[k]
            assert(v==v and math.abs(v)<math.huge and bounds and v>=bounds[1] and v<=bounds[2],"Out of range: "..k)
        elseif k=="UniformName" then assert(#v<=250 and (v=="" or X.loadouts and X.loadouts[v]),"Unknown uniform")
        elseif k=="Part" then assert(v=="Head" or v=="Torso","Invalid target part")
        elseif k=="PriorityKey" then
            if v=="F1" then v="V" end
            local ok,key=pcall(function() return Enum.KeyCode[v] end)
            assert(ok and key and key~=Enum.KeyCode.F1 and key~=Enum.KeyCode.Unknown,"Invalid shortcut")
        elseif k=="TargetUsername" then assert(#v<=20 and (v=="" or v:match("^[%w_]+$")),"Invalid username") end
        output[k]=v
    end
    -- Deterministic migration for older profiles with incompatible modes enabled.
    if output.BulletPOV then output.InstantHit=false;output.Missle=false
    elseif output.Missle then output.InstantHit=false end
    if output.ArtFly then output.ArtSilent=false;output.ArtAim=false end
    return output
end
local function applySettings(input)
    local wanted=validatedSettings(input)
    local previous=table.clone(C)
    local function apply(values)
        for k,v in pairs(C) do if type(v)=="boolean" and v then setSetting(k,false) end end
        for k,v in pairs(values) do if type(v)~="boolean" then C[k]=v end end
        for k,v in pairs(values) do if type(v)=="boolean" and v then setSetting(k,true) end end
    end
    local ok,err=pcall(apply,wanted)
    if not ok then
        local restored,restoreError=pcall(apply,previous)
        if not restored then warn("Profile rollback: "..tostring(restoreError)) end
    end
    activeLock=nil;previewTarget=nil
    if bonusGuiClient then pcall(bonusGuiClient.setFormationMoraleIcon,X.naturalFormation) end
    for _,fn in ipairs(refreshers) do fn() end
    assert(ok,tostring(err))
end
local function saveProfile(name)
    ensureConfigs();name=checkedName(name)
    local settings=validatedSettings(C)
    writefile(configFolder.."/"..name..".json",Http:JSONEncode({version=1,placeId=game.PlaceId,settings=settings}))
end
local function loadProfile(name)
    ensureConfigs();name=checkedName(name)
    local raw=readfile(configFolder.."/"..name..".json")
    assert(#raw<=262144,"Profile is too large")
    local document=Http:JSONDecode(raw)
    assert(type(document)=="table" and document.version==1 and document.placeId==game.PlaceId,"Incompatible profile")
    applySettings(document.settings)
end

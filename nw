            assert(response.StatusCode==200,"Logo download failed (HTTP "..tostring(response.StatusCode).."). The Discord link may have expired.")
            assert(isPNG(response.Body),"The logo response was not a valid PNG")
            writefile(LOGO_FILE,response.Body)
        end
        return getcustomasset(LOGO_FILE)
    end)
    if not alive or not gui.Parent then return end
    if not ok then
        gui:SetAttribute("LogoStatus","Failed")
        warn("Modena logo: "..tostring(result));return

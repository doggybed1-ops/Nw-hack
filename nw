                end
            end
        end
        if C.Tracers then sample(p,p.position) end
        local done=X.cannonSim(p,dt,C.ArtZeroDrop and Vector3.zero or gravity)
        if C.Tracers and not done then sample(p,p.position) end
        if done and paths[p] then retire(paths[p]);paths[p]=nil end
        return done
    end
    X.replaceUpvalue(X.cannonSimParent,X.cannonSimIndex,replacement)
    -- The constructor's owner is authoritative for local handling; find the matching muzzle only for that owner.
    local constructor=X.cannonCreate
    X.replaceUpvalue(X.cannonCreateParent,X.cannonCreateSlot,function(position,velocity,owner)
        if owner==P and C.ArtZeroSpread and X.cannonModels then
            local folder=workspace:FindFirstChild("Cannons")

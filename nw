stopBulletPOV=function(reason)
    local state=bulletPOV
    if not state then return end
    bulletPOV=nil
    local elapsed=os.clock()-state.started
    if gui.Parent then
        gui:SetAttribute("BulletFlyExitReason",reason or "Stopped")
        gui:SetAttribute("BulletFlyElapsed",elapsed)
        gui:SetAttribute("BulletFlyRemaining",0)
    end
    print("BULLET_FLY_ENDED",reason or "Stopped",string.format("%.2fs",elapsed))
    if state.marker then state.marker:Destroy() end
    state.projectile.lifetime=0
    if state.projectile.destroy==state.destroyWrapper then state.projectile.destroy=state.originalDestroy end
    CAS:UnbindAction(bulletAction)
    UIS.MouseBehavior=state.mouseBehavior;UIS.MouseIconEnabled=state.mouseIcon
    if state.camera and state.camera.Parent then
        state.camera.CameraType=state.cameraType
        if state.subject and state.subject.Parent then state.camera.CameraSubject=state.subject
        else
            local humanoid=P.Character and P.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then state.camera.CameraSubject=humanoid end
        end
        state.camera.CFrame=state.cframe;state.camera.Focus=state.focus
    end
    if panel.Parent then panel.Visible=state.menuVisible end
    bulletHint.Visible=false
    local path=paths[state.projectile]
    if path then retire(path);paths[state.projectile]=nil end
    if gui.Parent then gui:SetAttribute("BulletPOVActive",false) end
end
local function startBulletPOV(projectile,cannon)
    if freeCamera.state then freeCamera.stop() end
    local camera=workspace.CurrentCamera
    if not camera then return end
    local direction=projectile.velocity.Magnitude>.01 and projectile.velocity.Unit or camera.CFrame.LookVector
    local state={cannon=cannon==true,hitCharacters={},projectile=projectile,camera=camera,cameraType=camera.CameraType,subject=camera.CameraSubject,
        cframe=camera.CFrame,focus=camera.Focus,mouseBehavior=UIS.MouseBehavior,mouseIcon=UIS.MouseIconEnabled,
        menuVisible=panel.Visible,started=os.clock(),duration=30,
        yaw=math.atan2(-direction.X,-direction.Z),pitch=math.asin(math.clamp(direction.Y,-1,1))}
    state.marker=make("Part",{Name="VGControlledBullet",Shape=Enum.PartType.Ball,
        Size=Vector3.new(.4,.4,.4),Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,
        CastShadow=false,Material=Enum.Material.Neon,Color=Color3.fromRGB(190,45,55),
        Position=projectile.position},workspace)
    state.originalDestroy=projectile.destroy
    if type(state.originalDestroy)=="function" then
        state.destroyWrapper=function(...)
            if bulletPOV==state then stopBulletPOV("Projectile destroyed by game") end
            return state.originalDestroy(...)
        end
        projectile.destroy=state.destroyWrapper
    end
    bulletPOV=state
    camera.CameraType=Enum.CameraType.Scriptable
    panel.Visible=false
    UIS.MouseBehavior=Enum.MouseBehavior.LockCenter;UIS.MouseIconEnabled=false
    CAS:BindActionAtPriority(bulletAction,function() return Enum.ContextActionResult.Sink end,false,6000,
        Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D,Enum.KeyCode.Space,Enum.KeyCode.LeftControl,
        Enum.KeyCode.RightControl,Enum.UserInputType.MouseButton1,Enum.UserInputType.MouseButton2)
    bulletHint.Visible=true;gui:SetAttribute("BulletPOVActive",true)
end

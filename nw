    for i,v in pairs(debug.getupvalues(create)) do
        if type(v)=="function" and debug.info(v,"n")=="simulateFirearmProjectile" then
            simIndex=i; originalSim=v
        elseif type(v)=="table" then addSpread(v) end
    end
end

function X.piercingBullet(projectile,dt,state)
    local position=projectile.position
    local movement=projectile.velocity*math.max(dt,0)
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
    params.CollisionGroup="Projectiles";params.IgnoreWater=true
    local ignore={workspace.CurrentCamera}
    if P.Character then table.insert(ignore,P.Character) end
    for character in pairs(state.hitCharacters) do if character.Parent then table.insert(ignore,character) end end
    params.FilterDescendantsInstances=ignore
    for _=1,32 do
        if movement.Magnitude<.001 then break end
        local hit=workspace:Raycast(position,movement,params)
        if not hit then break end
        -- Hats and other gear are nested below the character; their immediate parent is not the character.
        local character=hit.Instance
        local humanoid
        while character and character~=workspace do
            if character:IsA("Model") then humanoid=character:FindFirstChildOfClass("Humanoid");if humanoid then break end end
            character=character.Parent
        end
        local player=humanoid and Players:GetPlayerFromCharacter(character)
        if not player then projectile.position=hit.Position;return true end
        if player~=P and (not C.TeamCheck or player.Team~=P.Team) and not state.hitCharacters[character] and humanoid.Health>0 then
            local ok,err=pcall(X.damage.dealShot,player,humanoid,hit.Instance,hit.Position,os.clock()-state.started>=1 and hit.Instance.Name~="Head")
            if not ok then X.note("Hit request failed: "..tostring(err)) end
            gui:SetAttribute("BulletHitRequests",(gui:GetAttribute("BulletHitRequests") or 0)+1)
        end
        state.hitCharacters[character]=true;params:AddToFilter(character)
    end
    projectile.position=position+movement
    if projectile.attachment0 then projectile.attachment0.WorldPosition=projectile.position end
    if projectile.attachment1 then projectile.attachment1.WorldPosition=projectile.position-Vector3.new(0,.1,0) end
    return false
end

local function simulateControlledBullet(projectile,dt)
    local state=bulletPOV
    if not state or state.projectile~=projectile then return end
    if not (state.cannon and C.ArtUnlimited or not state.cannon and C.BulletFlyUnlimited) and os.clock()-state.started>=state.duration then stopBulletPOV("30-second timer finished");return true end
    local function pressed(key) return not UIS:GetFocusedTextBox() and UIS:IsKeyDown(key) and 1 or 0 end
    local rotation=state.rotation or CFrame.fromOrientation(state.pitch,state.yaw,0)
    local direction=rotation.LookVector*(pressed(Enum.KeyCode.W)-pressed(Enum.KeyCode.S))
        +rotation.RightVector*(pressed(Enum.KeyCode.D)-pressed(Enum.KeyCode.A))
        +Vector3.yAxis*(pressed(Enum.KeyCode.Space)-math.max(pressed(Enum.KeyCode.LeftControl),pressed(Enum.KeyCode.RightControl)))
    projectile.velocity=direction.Magnitude>.001 and direction.Unit*(state.cannon and C.ArtFlySpeed or C.BulletFlySpeed) or Vector3.zero
    if C.Tracers then sample(projectile,projectile.position) end
    local ok,done=true,false
    if projectile.velocity.Magnitude>.001 then
        if state.cannon then
            local speedScale=X.cannonSimSpeed or 1
            ok,done=pcall(X.cannonSim,projectile,dt/math.max(speedScale,.001),Vector3.zero)
        elseif C.BulletPierce and X.damage then
            ok,done=pcall(X.piercingBullet,projectile,dt,state)
        else ok,done=pcall(originalSim,projectile,dt,Vector3.zero) end
    end
    if not ok then stopBulletPOV("Simulation error");error(done) end
    if C.Tracers and not done then sample(projectile,projectile.position) end
    if done then stopBulletPOV("Impact or game simulation ended bullet") end
    return done
end

if originalSim and simIndex and debug.setupvalue then
    local counted=setmetatable({}, {__mode="k"})
    local redirectedShots=setmetatable({}, {__mode="k"})
    local locks=setmetatable({}, {__mode="k"})
    local targetCast=RaycastParams.new()
    targetCast.FilterType=Enum.RaycastFilterType.Include
    targetCast.CollisionGroup="Projectiles"
    targetCast.IgnoreWater=true
    local obstructionCast=RaycastParams.new()
    obstructionCast.FilterType=Enum.RaycastFilterType.Exclude
    obstructionCast.CollisionGroup="Projectiles"
    obstructionCast.IgnoreWater=true
    local missles=setmetatable({},{__mode="k"})
    wrapped=function(p,dt,gravity)
        if not alive or not p.isLocal then return originalSim(p,dt,gravity) end
        if not counted[p] then
            counted[p]=true;shots+=1
            if C.BulletPOV and not bulletPOV then startBulletPOV(p) end
        end
        if bulletPOV and bulletPOV.projectile==p then return simulateControlledBullet(p,dt) end
        local misslePart
        local missile
        if C.Missle and C.SilentAim then
            missile=missles[p]
            if not missile then
                missile={age=0,speed=p.velocity.Magnitude,launch=p.velocity,delay=C.MissleLaunch,turn=C.MissleTurnRate}
                missles[p]=missile
            end
        end
        if C.SilentAim and selectSilentTarget then
            -- Choose once per projectile. Never jump to a replacement player.
            if locks[p]==nil then
                local intended
                if os.clock()-pendingShotAt<1.5 then
                    intended=pendingShotTarget
                    pendingShotAt=-math.huge
                else intended=previewTarget end
                local chosen
                if intended then chosen=selectSilentTarget(intended,"flight") end
                -- Keep the click-time target through recoil/reticle hiding; recheck health/team/range only.
                if not chosen then chosen=selectSilentTarget(nil) end
                locks[p]=chosen or false
            end
            local player,part
            if locks[p] then player,part=selectSilentTarget(locks[p],"flight") end
            if part then
                if missile then misslePart=part end
                activeLock=player; activeLockAt=os.clock()
                local speed=missile and missile.speed or p.velocity.Magnitude
                local delta=part.Position-p.position
                if speed>.01 and delta.Magnitude>.01 then
                    -- Predict a moving target while retaining the projectile's speed.
                    local velocity=part.AssemblyLinearVelocity
                    local a=velocity:Dot(velocity)-speed*speed
                    local b=2*delta:Dot(velocity)
                    local c=delta:Dot(delta)
                    local travel=delta.Magnitude/speed
                    if math.abs(a)<1e-6 then
                        if math.abs(b)>1e-6 and -c/b>0 then travel=-c/b end
                    else
                        local discriminant=b*b-4*a*c
                        if discriminant>=0 then
                            local root=math.sqrt(discriminant)
                            local t1=(-b-root)/(2*a)
                            local t2=(-b+root)/(2*a)
                            if t1>0 and t2>0 then travel=math.min(t1,t2)
                            elseif t1>0 then travel=t1
                            elseif t2>0 then travel=t2 end
                        end
                    end
                    travel=math.clamp(travel,0,math.min(p.lifetime,2))
                    local point=part.Position+velocity*travel
                    local direction=point-p.position
                    if direction.Magnitude>.01 then
                        local heading=direction.Unit
                        if (missile or C.SmoothSteering) and p.velocity.Magnitude>.01 then
                            local from=p.velocity.Unit
                            local angle=math.acos(math.clamp(from:Dot(heading),-1,1))
                            local turningTime=missile and math.max(0,missile.age-missile.delay) or 1
                            local ramp=missile and math.clamp(turningTime/.2,0,1) or 1
                            ramp=ramp*ramp*(3-2*ramp)
                            local step=math.rad(missile and missile.turn or C.TurnRate)*math.clamp(dt,0,.1)*ramp
                            if angle>step and angle>.0001 then
                                local axis=from:Cross(heading)
                                if axis.Magnitude<.0001 then
                                    axis=from:Cross(math.abs(from.Y)<.9 and Vector3.yAxis or Vector3.xAxis)
                                end
                                heading=CFrame.fromAxisAngle(axis.Unit,step):VectorToWorldSpace(from)
                            end
                        end
                        p.velocity=missile and missile.age<missile.delay and missile.launch or heading*speed
                        if not missile then -- Missle follows the arc instead of teleporting.
                            -- Move past intervening cover only when a target surface
                            -- and an actual obstruction can both be located.
                            local current=part.Position-p.position
                            if current.Magnitude>.1 then
                                targetCast.FilterDescendantsInstances={part}
                                local targetHit=workspace:Raycast(p.position,current.Unit*(current.Magnitude+part.Size.Magnitude),targetCast)
                                local ignore={workspace.CurrentCamera}
                                if P.Character then table.insert(ignore,P.Character) end
                                obstructionCast.FilterDescendantsInstances=ignore
                                local obstruction=workspace:Raycast(p.position,current,obstructionCast)
                                local blocked=obstruction and not obstruction.Instance:IsDescendantOf(player.Character)
                                local canTransfer=C.InstantHit and not C.BulletPOV and not C.Missle
                                if targetHit and canTransfer then
                                    local oldPath=paths[p]
                                    if oldPath then retire(oldPath); paths[p]=nil end
                                    local beforeTransfer=p.position
                                    p.position=targetHit.Position-current.Unit*.03
                                    drawInstantTrace(beforeTransfer,p.position)
                                    p.velocity=current.Unit*speed
                                    if blocked then
                                        wallTransfers+=1
                                        print("WALL_TRANSFER",player.DisplayName,obstruction.Instance.Name)
                                    end
                                    if C.InstantHit then
                                        instantTransfers+=1
                                        print("INSTANT_TRANSFER",player.DisplayName)
                                    end
                                end
                            end
                        end
                        if not redirectedShots[p] then
                            redirectedShots[p]=true
                            redirected+=1
                            print("SILENT_REDIRECT",player.DisplayName,"speed",speed)
                        end
                        lastSilentTarget=player.DisplayName..(player.Character:FindFirstChildOfClass("ForceField") and " (Godded)" or "")
                    end
                end
            end
        else locks[p]=false end

        if missile and misslePart then
            missile.age+=math.max(dt,0)
            local before=p.position
            local movement=p.velocity*math.max(dt,0)
            if C.Tracers then sample(p,before) end
            targetCast.FilterDescendantsInstances={misslePart}
            local hit=movement.Magnitude>.0001 and workspace:Raycast(before,movement,targetCast)
            if hit then
                -- Resolve only the final contact through the game's usual hit handling.
                local direction=movement.Unit
                p.position=hit.Position-direction*.03
                local done=originalSim(p,.06/math.max(missile.speed,.01),Vector3.zero)
                if C.Tracers then sample(p,hit.Position) end
                local path=paths[p]
                if path then retire(path);paths[p]=nil end
                missles[p]=nil
                return done
            end
            p.position=before+movement
            if p.attachment0 then p.attachment0.WorldPosition=p.position end
            if p.attachment1 then p.attachment1.WorldPosition=p.position-Vector3.new(0,.1,0) end
            if C.Tracers then sample(p,p.position) end
            local path=paths[p]
            if path and (not C.Tracers or p.lifetime<=dt*2) then retire(path);paths[p]=nil end
            return false
        end

        if C.Tracers then sample(p,p.position) end
        local done=originalSim(p,dt,C.ZeroDrop and Vector3.zero or gravity)
        if C.Tracers and not done then sample(p,p.position) end
        local r=paths[p]
        if r and (done or not C.Tracers or p.lifetime<=dt*2) then retire(r); paths[p]=nil end
        return done
    end
    debug.setupvalue(create,simIndex,wrapped)
end



local function addSpread(t)
    if type(t)~="table" or type(rawget(t,"ProjectileSpread"))~="number" then return end
    for _,e in ipairs(spreadEntries) do if e.t==t then return end end
    table.insert(spreadEntries,{t=t,value=t.ProjectileSpread})
end

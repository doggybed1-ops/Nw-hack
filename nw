-- Persistent segment for instantaneous client displacement. A Trail cannot
-- render this reliably when both endpoints change within the same frame.

local function tracerColor()
    return ColorSequence.new(Color3.fromHSV(C.TracerRainbow and (os.clock()*.12%1) or C.TracerHue/360,.7,1))
end
local function tracerTransparency()
    local alpha=1-C.TracerOpacity/100
    return C.TracerFade and NumberSequence.new(alpha,1) or NumberSequence.new(alpha)
end
do
    local elapsed=0
    connect(Run.Heartbeat,function(dt)
        elapsed+=dt;if elapsed<.05 then return end;elapsed=0
        for record in pairs(records) do
            local effect=record.trail or record.beam
            if effect and effect.Parent then
                effect.Color=tracerColor()
                if record.beam then
                    local transparency=1-C.TracerOpacity/100
                    if C.TracerFade then transparency=transparency+(1-transparency)*math.clamp((os.clock()-record.created)/record.duration,0,1) end
                    effect.Transparency=NumberSequence.new(transparency)
                    effect.Width0=C.TrailWidth;effect.Width1=C.TrailWidth
                else effect.Transparency=tracerTransparency() end
            end
        end
    end)
end

local function drawInstantTrace(from,to)
    if not C.Tracers or (to-from).Magnitude<.05 then return end
    local a=make("Attachment",{Name="VGTraceOrigin",WorldPosition=from},workspace.Terrain)
    local b=make("Attachment",{Name="VGTraceEnd",WorldPosition=to},workspace.Terrain)
    local beam=make("Beam",{Name="VGInstantTrace",Attachment0=a,Attachment1=b,
        Width0=C.TrailWidth,Width1=C.TrailWidth,FaceCamera=true,
        Color=tracerColor(),
        Transparency=NumberSequence.new(1-C.TracerOpacity/100),LightEmission=1,Segments=1},a)
    local record={a=a,b=b,beam=beam,created=os.clock(),duration=C.TrailSeconds,done=true};records[record]=true
    a.Destroying:Connect(function() records[record]=nil end)
    Debris:AddItem(a,C.TrailSeconds);Debris:AddItem(b,C.TrailSeconds)
    instantTraceCount+=1
end
local function retire(r)
    if r.done then return end
    r.done=true; r.trail.Enabled=false
    Debris:AddItem(r.a,C.TrailSeconds+.2)
    Debris:AddItem(r.b,C.TrailSeconds+.2)
end
local function sample(p,position)
    local r=paths[p]
    if not r then
        local a=make("Attachment",{WorldPosition=position},workspace.Terrain)
        local b=make("Attachment",{WorldPosition=position+Vector3.new(0,C.TrailWidth,0)},workspace.Terrain)
        local trail=make("Trail",{Attachment0=a,Attachment1=b,FaceCamera=true,
            Color=tracerColor(),LightEmission=1,
            Transparency=tracerTransparency(),MinLength=0,MaxLength=0,
            Lifetime=C.TrailSeconds,WidthScale=NumberSequence.new(1)},a)
        r={a=a,b=b,trail=trail}; paths[p]=r; records[r]=true
        a.Destroying:Connect(function() records[r]=nil end)
    end
    r.a.WorldPosition=position
    r.b.WorldPosition=position+Vector3.new(0,C.TrailWidth,0)
    r.trail.Lifetime=C.TrailSeconds
    samples+=1
end


local function number(key,name,lo,hi)
    local steps={Radius=1,FOVWidth=1,Response=1,MaxDistance=10,LeadSeconds=.005,TrailSeconds=.1,TrailWidth=.01}
    local step=steps[key] or 1
    local host=list
    local row=make("Frame",{Name="Slider_"..key,Size=UDim2.new(1,-6,0,62),BackgroundTransparency=1},list)
    label(name,row,UDim2.new(.72,0,0,28))
    local box=make("TextBox",{Position=UDim2.new(.75,0,0,0),Size=UDim2.new(.25,0,0,26),
        Text=tostring(C[key]),ClearTextOnFocus=false,TextSize=12,Font=Enum.Font.Code,
        TextColor3=Color3.new(1,1,1),BackgroundColor3=Color3.fromRGB(20,48,79)},row)
    local track=make("TextButton",{Name="Track",Text="",Position=UDim2.new(0,6,0,39),
        Size=UDim2.new(1,-12,0,10),BackgroundColor3=Color3.fromRGB(27,58,93),BorderSizePixel=0,
        AutoButtonColor=false},row)
    make("UICorner",{CornerRadius=UDim.new(1,0)},track)
    local fill=make("Frame",{Size=UDim2.new(),BackgroundColor3=Color3.fromRGB(58,157,255),BorderSizePixel=0},track)
    make("UICorner",{CornerRadius=UDim.new(1,0)},fill)
    local knob=make("Frame",{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(16,16),
        BackgroundColor3=Color3.fromRGB(229,247,255),BorderSizePixel=0},track)
    make("UICorner",{CornerRadius=UDim.new(1,0)},knob)
    local function update()
        box.Text=string.format("%.3f",C[key]):gsub("0+$",""):gsub("%.$","")
        local alpha=math.clamp((C[key]-lo)/(hi-lo),0,1)
        fill.Size=UDim2.new(alpha,0,1,0)
        knob.Position=UDim2.new(alpha,0,.5,0)
    end
    local function assign(n)
        C[key]=math.clamp(math.floor(n/step+.5)*step,lo,hi)
        update()
    end
    connect(box.FocusLost,function()
        local n=tonumber(box.Text)
        if n and n==n and math.abs(n)<math.huge then assign(n) else update() end
    end)
    local dragging=false
    local touch
    local function fromX(x)
        local left=track.AbsolutePosition.X-gui.AbsolutePosition.X
        local alpha=math.clamp((x-left)/math.max(track.AbsoluteSize.X,1),0,1)
        assign(lo+(hi-lo)*alpha)
    end
    connect(track.InputBegan,function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dragging=true; touch=i.UserInputType==Enum.UserInputType.Touch and i or nil
            host.ScrollingEnabled=false; fromX(i.Position.X)
        end
    end)
    connect(UIS.InputChanged,function(i)
        if dragging and ((touch and i==touch) or (not touch and i.UserInputType==Enum.UserInputType.MouseMovement)) then
            fromX(i.Position.X)
        end
    end)
    connect(UIS.InputEnded,function(i)
        if dragging and ((touch and i==touch) or (not touch and i.UserInputType==Enum.UserInputType.MouseButton1)) then
            dragging=false; touch=nil; host.ScrollingEnabled=true
        end
    end)
    table.insert(refreshers,update); update()
end

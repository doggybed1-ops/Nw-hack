-- Executor capability checks and bounded module discovery.
local VGCompat={modules=setmetatable({},{__mode="k"}),pending=0,limit=8,timeout=.25}
do
    local missing={}
    for name,available in pairs({
        getloadedmodules=type(getloadedmodules)=="function",
        ["debug.getupvalues"]=type(debug)=="table" and type(debug.getupvalues)=="function",
        ["debug.setupvalue"]=type(debug)=="table" and type(debug.setupvalue)=="function",
        ["debug.info"]=type(debug)=="table" and type(debug.info)=="function"
    }) do
        if not available then table.insert(missing,name) end
    end
    table.sort(missing)
    assert(#missing==0,"VG Client: executor is missing required functions: "..table.concat(missing,", "))
end
function VGCompat.loadedModules()
    local ok,result=pcall(getloadedmodules)
    assert(ok and type(result)=="table","VG Client: getloadedmodules failed: "..tostring(result))
    return result
end
function VGCompat.requireModule(module)
    if typeof(module)~="Instance" or not module:IsA("ModuleScript") then
        return false,"Not a ModuleScript"
    end
    local entry=VGCompat.modules[module]
    if not entry then
        if VGCompat.pending>=VGCompat.limit then return false,"Module discovery is busy" end
        entry={done=false};VGCompat.modules[module]=entry;VGCompat.pending+=1
        -- pcall alone does not protect the caller from an indefinitely yielding require.
        task.spawn(function()
            local ok,value=pcall(require,module)
            entry.ok=ok;entry.value=value;entry.done=true
            VGCompat.pending-=1
        end)
    end
    if not entry.done and not entry.timedOut then
        local deadline=os.clock()+VGCompat.timeout
        repeat task.wait() until entry.done or os.clock()>=deadline
        if not entry.done then
            entry.timedOut=true
            warn("VG Client: module is still loading; continuing startup: "..module:GetFullName())
        end
    end
    -- Keep the pending result so later scans can discover a module that eventually loads.
    -- Do not cancel its coroutine or start duplicate requires.
    if not entry.done then return false,"Module is still loading" end
    return entry.ok,entry.value
end
